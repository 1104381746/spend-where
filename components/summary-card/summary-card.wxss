.summary-card {
  background: linear-gradient(135deg, #1A1A2E, #16213E);
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  color: #E0E0F0;
  margin: 20rpx 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

.card-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}

.balance-label {
  font-size: 24rpx;
  opacity: 0.7;
  margin-bottom: 8rpx;
}

.balance-amount {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.card-body {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stat-icon {
  font-size: 28rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.stat-item.income .stat-icon {
  background: rgba(74, 222, 128, 0.25);
  color: #60db8e;
}

.stat-item.expense .stat-icon {
  background: rgba(255, 126, 126, 0.25);
  color: #FF7E7E;
}

.stat-info {
  display: flex;
  flex-direction: column;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.7;
  margin-bottom: 4rpx;
}

.stat-amount {
  font-size: 34rpx;
  font-weight: 700;
}

.stat-item.income .stat-amount {
  color: #60db8e;
}

.stat-item.expense .stat-amount {
  color: #FF7E7E;
}

.stat-divider {
  width: 1rpx;
  height: 52rpx;
  background: rgba(255, 255, 255, 0.15);
}
