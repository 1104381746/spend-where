.summary-card {
  background: linear-gradient(135deg, #07C160, #06AD56);
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  color: #FFFFFF;
  margin: 20rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(7, 193, 96, 0.3);
}

.month-label {
  font-size: 24rpx;
  opacity: 0.85;
  margin-bottom: 12rpx;
}

.balance {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.card-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stat-item {
  flex: 1;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.8;
  margin-bottom: 6rpx;
}

.stat-amount {
  font-size: 32rpx;
  font-weight: 600;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 24rpx;
}