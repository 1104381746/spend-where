<view class="summary-card">
  <view class="card-header">
    <text class="balance-label">本月结余</text>
    <text class="balance-amount">¥{{formattedBalance}}</text>
  </view>
  <view class="card-body">
    <view class="stat-item income">
      <view class="stat-info">
        <text class="stat-label">赚了</text>
        <text class="stat-amount">¥{{formattedIncome}}</text>
      </view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item expense">
      <view class="stat-info">
        <text class="stat-label">花了</text>
        <text class="stat-amount">¥{{formattedExpense}}</text>
      </view>
    </view>
  </view>
</view>
