.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 20rpx 0;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  border-radius: var(--radius-base);
}

.category-item.selected {
  background: rgba(74, 222, 128, 0.1);
}

.category-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border: 2rpx solid transparent;
  margin-bottom: 8rpx;
}

.category-name {
  font-size: 24rpx;
  color: var(--text-primary);
}

.expand-btn {
  grid-column: 1 / -1;
  text-align: center;
  padding: 16rpx 0 0;
  font-size: 24rpx;
  color: var(--text-hint);
}
