<view class="page">
  <!-- 金额输入区域 -->
  <view class="amount-section">
    <view class="amount-label">金额</view>
    <view class="amount-input-wrapper">
      <text class="amount-currency">¥</text>
      <input
        class="amount-input"
        type="digit"
        value="{{amount}}"
        placeholder="0.00"
        focus
        bindinput="onAmountInput"
      />
    </view>
  </view>

  <!-- 收入/支出 切换 -->
  <view class="type-switcher">
    <view
      class="type-btn {{type === 'expense' ? 'active-expense' : ''}}"
      data-type="expense"
      bindtap="switchType"
    >支出</view>
    <view
      class="type-btn {{type === 'income' ? 'active-income' : ''}}"
      data-type="income"
      bindtap="switchType"
    >收入</view>
  </view>

  <!-- 分类选择 -->
  <view class="section">
    <view class="section-title">分类</view>
    <category-grid
      type="{{type}}"
      selected="{{category}}"
      bind:select="onSelectCategory"
    />
  </view>

  <!-- 日期选择 -->
  <view class="section">
    <view class="section-title">日期</view>
    <picker mode="date" value="{{date}}" bindchange="onDateChange">
      <view class="picker-value">{{dateDisplay}}</view>
    </picker>
  </view>

  <!-- 备注输入 -->
  <view class="section">
    <view class="section-title">备注</view>
    <input
      class="note-input"
      type="text"
      value="{{note}}"
      placeholder="添加备注（可选）"
      bindinput="onNoteInput"
      maxlength="50"
    />
  </view>

  <!-- 保存按钮 -->
  <view class="save-section">
    <button
      class="save-btn {{saving ? 'disabled' : ''}}"
      bindtap="onSave"
      disabled="{{saving}}"
    >
      {{saving ? '保存中...' : '保存'}}
    </button>
  </view>
</view>