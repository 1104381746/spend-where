.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 40rpx;
}

.amount-section {
  background: #FFFFFF;
  padding: 48rpx 32rpx 32rpx;
  text-align: center;
}

.amount-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

.amount-input-wrapper {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.amount-currency {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  margin-right: 8rpx;
}

.amount-input {
  font-size: 56rpx;
  font-weight: 700;
  color: #333333;
  text-align: center;
  width: 300rpx;
}

.type-switcher {
  display: flex;
  background: #FFFFFF;
  padding: 0 32rpx 32rpx;
  gap: 20rpx;
  justify-content: center;
}

.type-btn {
  flex: 1;
  max-width: 200rpx;
  padding: 12rpx 0;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  background: #F5F5F5;
  color: #666666;
  transition: all 0.2s;
}

.type-btn.active-expense {
  background: #FFF0F0;
  color: #EE0A24;
  font-weight: 600;
}

.type-btn.active-income {
  background: #E8F8EE;
  color: #07C160;
  font-weight: 600;
}

.section {
  background: #FFFFFF;
  margin-top: 16rpx;
  padding: 24rpx 32rpx;
}

.section-title {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.picker-value {
  font-size: 28rpx;
  color: #333333;
  padding: 8rpx 0;
}

.note-input {
  font-size: 28rpx;
  color: #333333;
  padding: 8rpx 0;
  width: 100%;
}

.save-section {
  margin: 60rpx 32rpx 0;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #07C160;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  text-align: center;
  border: none;
}

.save-btn.disabled {
  opacity: 0.6;
}