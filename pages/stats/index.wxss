.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 40rpx;
}

/* 月/年/日历 切换 */
.view-switcher {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 12rpx;
  background: #FFFFFF;
}

.view-btn {
  padding: 12rpx 36rpx;
  font-size: 28rpx;
  color: #666666;
  border: 1rpx solid #DDDDDD;
  transition: all 0.2s;
}

.view-btn:first-child { border-radius: 8rpx 0 0 8rpx; border-right: none; }
.view-btn:last-child { border-radius: 0 8rpx 8rpx 0; border-left: none; }
.view-btn:nth-child(2) { border-radius: 0; border-left: none; }

.view-btn.active {
  background: #07C160;
  color: #FFFFFF;
  border-color: #07C160;
}

/* 日期导航 */
.date-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.nav-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #333;
  line-height: 1;
}

.nav-btn:active { background: #E5E5E5; }

.nav-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #333333;
}

/* 汇总卡片 */
.summary-cards {
  display: flex;
  margin: 20rpx 24rpx;
  gap: 12rpx;
}

.summary-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.summary-item.income .summary-value { color: #07C160; }
.summary-item.expense .summary-value { color: #EE0A24; }
.summary-item.balance .summary-value { color: #333333; }

.summary-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.summary-value {
  font-size: 32rpx;
  font-weight: 700;
}

/* 图表区域 */
.chart-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  padding: 28rpx 24rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.chart-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

.chart-hint {
  font-size: 22rpx;
  font-weight: 400;
  color: #BBBBBB;
  margin-left: 12rpx;
}

.chart-wrap {
  width: 100%;
  height: 440rpx;
}

.chart-wrap.pie-wrap {
  height: 480rpx;
}

.chart-canvas {
  width: 100%;
  height: 100%;
}

/* 日历 */
.calendar-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  padding: 24rpx 16rpx 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.weekday-row {
  display: flex;
  margin-bottom: 8rpx;
}

.weekday-item {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #999;
  padding: 8rpx 0;
}

.calendar-grid {
  display: flex;
  flex-direction: column;
}

.calendar-row {
  display: flex;
}

.calendar-cell {
  flex: 1;
  height: 90rpx;
  padding: 3rpx;
  box-sizing: border-box;
}

.calendar-cell.empty {
  visibility: hidden;
}

.calendar-cell.clickable:active {
  opacity: 0.7;
}

.calendar-cell.expanded .cell-inner {
  border: 3rpx solid #07C160;
}

.cell-inner {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 热力色阶 */
.cell-lv0 { background: #FAFAFA; }
.cell-lv1 { background: #FFF0F0; }
.cell-lv2 { background: #FFD4D4; }
.cell-lv3 { background: #FF8A8A; }
.cell-lv4 { background: #EE0A24; }

.cell-lv4 .cell-day { color: #FFFFFF; }
.cell-lv4 .cell-expense { color: rgba(255,255,255,0.85); }

.cell-day-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.cell-day {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
}

.income-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #07C160;
  flex-shrink: 0;
}

.cell-expense {
  font-size: 16rpx;
  font-weight: 500;
  color: #EE0A24;
  margin-top: 2rpx;
}

/* 展开的当日记录 */
.expanded-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.expanded-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.expanded-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
}

.expanded-close {
  font-size: 24rpx;
  color: #999;
  padding: 4rpx 12rpx;
}

.expanded-loading {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: #999;
}

.expanded-records {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.expanded-record-item {
  display: flex;
  align-items: center;
  padding: 16rpx 12rpx;
  border-bottom: 1rpx solid #F5F5F5;
  gap: 12rpx;
}

.expanded-record-item:last-child {
  border-bottom: none;
}

.expando-icon {
  font-size: 24rpx;
  width: 36rpx;
  text-align: center;
  flex-shrink: 0;
}

.expando-cat {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.expando-note {
  font-size: 22rpx;
  color: #999;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.expando-amount {
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.ex-color { color: #EE0A24; }
.in-color { color: #07C160; }

.expanded-empty {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: #999;
}

/* 加载 & 空状态 */
.loading {
  text-align: center;
  padding: 120rpx 0;
  color: #999999;
  font-size: 28rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-chart-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #666666;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #BBBBBB;
}
