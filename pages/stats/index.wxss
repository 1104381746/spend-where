.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 40rpx;
}

/* 月/年 切换 */
.view-switcher {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 12rpx;
  background: #FFFFFF;
}

.view-btn {
  padding: 12rpx 56rpx;
  font-size: 28rpx;
  color: #666666;
  border: 1rpx solid #DDDDDD;
  transition: all 0.2s;
}

.view-btn:first-child {
  border-radius: 8rpx 0 0 8rpx;
  border-right: none;
}

.view-btn:last-child {
  border-radius: 0 8rpx 8rpx 0;
  border-left: none;
}

.view-btn.active {
  background: #07C160;
  color: #FFFFFF;
  border-color: #07C160;
}

/* 日期导航 */
.date-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.nav-btn {
  padding: 8rpx 24rpx;
  font-size: 36rpx;
  color: #07C160;
  font-weight: 300;
}

.nav-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

/* 汇总卡片 */
.summary-cards {
  display: flex;
  margin: 20rpx 24rpx;
  gap: 12rpx;
}

.summary-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.summary-item.income .summary-value {
  color: #07C160;
}

.summary-item.expense .summary-value {
  color: #EE0A24;
}

.summary-item.balance .summary-value {
  color: #333333;
}

.summary-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.summary-value {
  font-size: 32rpx;
  font-weight: 700;
}

/* 图表区域 */
.chart-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.chart-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

.chart-canvas {
  width: 100%;
  height: 400rpx;
}

/* 加载 & 空状态 */
.loading {
  text-align: center;
  padding: 80rpx 0;
  color: #999999;
  font-size: 28rpx;
}

.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}