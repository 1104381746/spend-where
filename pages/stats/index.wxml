<view class="page">
  <view class="view-switcher">
    <view class="view-btn {{mode==='month'?'active':''}}" data-mode="month" bindtap="switchMode">月</view>
    <view class="view-btn {{mode==='year'?'active':''}}" data-mode="year" bindtap="switchMode">年</view>
    <view class="view-btn {{mode==='calendar'?'active':''}}" data-mode="calendar" bindtap="switchMode">日历</view>
  </view>

  <view class="date-nav" wx:if="{{mode !== 'year'}}">
    <view class="nav-btn" bindtap="changeMonth" data-direction="prev">‹</view>
    <view class="nav-label">{{monthLabel}}</view>
    <view class="nav-btn" bindtap="changeMonth" data-direction="next">›</view>
  </view>

  <view class="date-nav" wx:if="{{mode === 'year'}}">
    <view class="nav-btn" bindtap="changeYear" data-direction="prev">‹</view>
    <view class="nav-label">{{yearLabel}}</view>
    <view class="nav-btn" bindtap="changeYear" data-direction="next">›</view>
  </view>

  <!-- 汇总卡片 -->
  <view class="summary-cards">
    <view class="summary-item income">
      <view class="summary-label">收入</view>
      <view class="summary-value">¥{{totalIncomeStr}}</view>
    </view>
    <view class="summary-item expense">
      <view class="summary-label">支出</view>
      <view class="summary-value">¥{{totalExpenseStr}}</view>
    </view>
    <view class="summary-item balance">
      <view class="summary-label">结余</view>
      <view class="summary-value">¥{{balanceStr}}</view>
    </view>
  </view>

  <!-- 图表视图 -->
  <block wx:if="{{mode !== 'calendar'}}">
    <block wx:if="{{chartsReady}}">
      <view class="chart-section">
        <view class="chart-title">收支趋势 <text class="chart-hint">点击柱体查看详情</text></view>
        <view class="chart-wrap">
          <ec-canvas id="barChart" class="chart-canvas" canvas-id="barChart" ec="{{barEc}}"></ec-canvas>
        </view>
      </view>
      <view class="chart-section" wx:if="{{totalExpense > 0}}">
        <view class="chart-title">支出分类占比 <text class="chart-hint">点击扇区查看详情</text></view>
        <view class="chart-wrap pie-wrap">
          <ec-canvas id="pieChart" class="chart-canvas" canvas-id="pieChart" ec="{{pieEc}}"></ec-canvas>
        </view>
      </view>
    </block>
  </block>

  <!-- 日历视图 -->
  <block wx:if="{{mode === 'calendar'}}">
    <view class="calendar-card" wx:if="{{calendarData}}">
      <view class="weekday-row">
        <text class="weekday-item">日</text>
        <text class="weekday-item">一</text>
        <text class="weekday-item">二</text>
        <text class="weekday-item">三</text>
        <text class="weekday-item">四</text>
        <text class="weekday-item">五</text>
        <text class="weekday-item">六</text>
      </view>
      <view class="calendar-grid">
        <block wx:for="{{calendarData}}" wx:key="*this" wx:for-item="row">
          <view class="calendar-row">
            <block wx:for="{{row}}" wx:key="*this" wx:for-item="cell">
              <view class="calendar-cell empty" wx:if="{{!cell}}"></view>
              <view
                class="calendar-cell {{cell.hasData ? 'clickable' : ''}} {{expandedDate===cell.date ? 'expanded' : ''}}"
                wx:if="{{cell}}"
                data-cell="{{cell}}"
                bindtap="onTapCalendarCell"
              >
                <view class="cell-inner cell-lv{{cell.level}} {{cell.hasData ? 'has-data' : ''}}">
                  <view class="cell-day-row">
                    <view class="income-dot" wx:if="{{cell.income > 0}}"></view>
                    <text class="cell-day">{{cell.day}}</text>
                  </view>
                  <text class="cell-expense" wx:if="{{cell.expense > 0}}">¥{{cell.expenseStr}}</text>
                </view>
              </view>
            </block>
          </view>
        </block>
      </view>
    </view>

    <!-- 展开的当日记录 -->
    <view class="expanded-section" wx:if="{{expandedDate}}">
      <view class="expanded-header">
        <text class="expanded-title">{{expandedDateLabel}}</text>
        <text class="expanded-close" bindtap="onTapCalendarCell" data-cell="{{null}}">收起</text>
      </view>
      <view class="expanded-loading" wx:if="{{expandedDateLoading}}">
        <text>加载中...</text>
      </view>
      <view class="expanded-records" wx:elif="{{expandedDateRecords.length > 0}}">
        <view wx:for="{{expandedDateRecords}}" wx:key="_id" class="expanded-record-item">
          <text class="expando-cat">{{item.category}}</text>
          <text class="expando-note" wx:if="{{item.note}}">{{item.note}}</text>
          <text class="expando-amount {{item.type==='expense'?'ex-color':'in-color'}}">
            {{item.type==='expense'?'-':'+'}}¥{{item.amount}}
          </text>
        </view>
      </view>
      <view class="expanded-empty" wx:else>
        <text>暂无记录</text>
      </view>
    </view>

    <view class="empty-state" wx:if="{{calendarData && !hasCalendarData}}">
      <view class="empty-chart-icon">📅</view>
      <text class="empty-title">暂无记录</text>
      <text class="empty-desc">本月还没有记账记录</text>
    </view>
  </block>

  <view class="loading" wx:if="{{loading}}"><text>加载中...</text></view>

  <view class="empty-state" wx:if="{{!loading && mode !== 'calendar' && !chartsReady}}">
    <view class="empty-chart-icon">📊</view>
    <text class="empty-title">暂无数据</text>
    <text class="empty-desc">{{mode==='month'?'本月还没有记账记录':'今年还没有记账记录'}}</text>
    <text class="empty-hint">添加记录后这里会展示统计图表</text>
  </view>
</view>
