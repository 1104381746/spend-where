.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #0D0D1D;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.question-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 10rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 700;
  color: #E0E0F0;
  margin-bottom: 16rpx;
  letter-spacing: 8rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #6868A0;
  letter-spacing: 4rpx;
}
