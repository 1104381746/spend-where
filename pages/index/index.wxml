<view class="page">
  <!-- 月份导航 -->
  <view class="month-nav">
    <view class="nav-arrow" bindtap="prevMonth">‹</view>
    <view class="month-title">{{monthLabel}}</view>
    <view class="nav-arrow" bindtap="nextMonth">›</view>
  </view>

  <!-- 月度汇总卡片 -->
  <view class="card-wrapper" bindtap="goToStats">
    <summary-card
      totalIncome="{{totalIncome}}"
      totalExpense="{{totalExpense}}"
      balance="{{balance}}"
    />
  </view>

  <!-- 记录列表 -->
  <view class="list-container">
    <scroll-view
      scroll-y
      class="scroll-view"
      refresher-enabled
      refresher-triggered="{{refreshing}}"
      bindrefresherrefresh="onRefresh"
      bindscrolltolower="onLoadMore"
      lower-threshold="100"
    >
      <!-- 有记录时 -->
      <block wx:for="{{groupedRecords}}" wx:key="date" wx:for-item="group" wx:for-index="gi">
        <view class="date-header">
          <text class="date-label">{{group.dateLabel}}</text>
          <view class="date-summary">
            <text class="day-income" wx:if="{{group.dayIncome > 0}}">收 ¥{{group.dayIncomeStr}}</text>
            <text class="day-expense" wx:if="{{group.dayExpense > 0}}">支 ¥{{group.dayExpenseStr}}</text>
          </view>
        </view>
        <view class="date-group">
          <block wx:for="{{group.items}}" wx:key="_id">
            <record-item
              record="{{item}}"
              bind:taprecord="onTapRecord"
              bind:deleterecord="onDeleteRecord"
            />
          </block>
        </view>
      </block>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{groupedRecords.length === 0 && !loading}}">
        <view class="empty-icon">📝</view>
        <view class="empty-text">还没有记账记录</view>
        <view class="empty-hint">点击下方记账开始记录</view>
      </view>

      <!-- 加载状态 -->
      <view class="load-more" wx:if="{{loading}}">
        <text wx:if="{{page === 0}}">加载中...</text>
        <text wx:else>加载更多...</text>
      </view>

      <view class="no-more" wx:if="{{!hasMore && records.length > 0}}">— 没有更多了 —</view>
    </scroll-view>
  </view>

  <!-- 删除确认弹窗 -->
  <view class="modal-overlay" wx:if="{{showDeleteModal}}" bindtap="cancelDelete">
    <view class="modal-content" catchtap>
      <view class="modal-title">确认删除</view>
      <view class="modal-body">确定要删除这笔记录吗？删除后不可恢复。</view>
      <view class="modal-actions">
        <view class="modal-btn cancel" bindtap="cancelDelete">取消</view>
        <view class="modal-btn confirm" bindtap="confirmDelete">删除</view>
      </view>
    </view>
  </view>
</view>
