<view class="page">
  <view class="user-card">
    <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"/>
    <view class="user-name">{{userInfo.nickName}}</view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="goToCategories" data-type="expense">
      <text class="menu-label">支出类别</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToCategories" data-type="income">
      <text class="menu-label">收入类别</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
