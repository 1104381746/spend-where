<view class="page">
  <view class="user-card">
    <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"/>
    <view class="user-name">{{userInfo.nickName}}</view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="goToCategories" data-type="expense">
      <text class="menu-label">类别管理</text>
      <text class="menu-arrow">›</text>
    </view>
    <button class="menu-item share-btn" open-type="share">
      <text class="menu-label">分享小程序</text>
      <text class="menu-arrow">›</text>
    </button>
  </view>

  <view class="logout-section">
    <view class="logout-btn" bindtap="onLogout">退出登录</view>
  </view>
</view>
