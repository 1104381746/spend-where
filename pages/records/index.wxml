<view class="page">
  <view class="filter-bar" wx:if="{{filterLabel}}">
    <text class="filter-label">{{filterLabel}}</text>
    <view class="filter-tag" wx:if="{{filterDate}}">{{filterDate}}</view>
    <view class="filter-tag" wx:elif="{{filterCategory}}">{{filterCategory}}</view>
  </view>

  <scroll-view
    scroll-y
    class="scroll-view"
    bindscrolltolower="onLoadMore"
    lower-threshold="100"
  >
    <view class="record-list">
      <block wx:for="{{records}}" wx:key="_id">
        <record-item
          record="{{item}}"
          bind:taprecord="onTapRecord"
        />
      </block>
    </view>

    <view class="load-more" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>

    <view class="no-more" wx:if="{{!hasMore && records.length > 0}}">
      — 没有更多了 —
    </view>

    <view class="empty-state" wx:if="{{!loading && records.length === 0}}">
      <view class="empty-icon">📋</view>
      <text class="empty-text">没有符合条件的记录</text>
    </view>
  </scroll-view>
</view>
