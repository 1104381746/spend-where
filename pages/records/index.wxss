.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F5F5;
}

.filter-bar {
  padding: 20rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.filter-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.filter-tag {
  font-size: 22rpx;
  color: #07C160;
  background: #07C16015;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.scroll-view {
  flex: 1;
}

.record-list {
  background: #FFFFFF;
  margin: 16rpx 0;
}

.load-more, .no-more {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
