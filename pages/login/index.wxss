.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--bg-color);
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}

.logo {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.app-desc {
  font-size: 28rpx;
  color: var(--text-hint);
}
.question-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 10rpx;
}

.login-section {
  width: 80%;
  margin-top: 20rpx;
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--card-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin-bottom: 32rpx;
  border: 2rpx dashed var(--text-hint);
}

.avatar-btn::after {
  border: none;
}

.avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  font-size: 22rpx;
  color: var(--text-hint);
  text-align: center;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--card-bg);
  color: var(--text-primary);
  font-size: 30rpx;
  border-radius: 44rpx;
  text-align: center;
  margin-bottom: 40rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
}

.login-btn[disabled] {
  background: var(--text-hint);
  color: var(--text-secondary);
}

.login-btn::after {
  border: none;
}
